{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kpmg-rag.local/schemas/data_rag_chunk_v1.schema.json",
  "title": "Data Engineering to RAG Chunk v1",
  "type": "object",
  "required": [
    "chunk_id", "text", "accession_number", "cik", "company_name", "ticker",
    "form", "filing_date", "reporting_period_end", "chunk_index", "section_id",
    "section_type", "original_title", "is_table", "source_url", "chunking_version",
    "extraction_version", "source_sha256", "offset_start", "offset_end"
  ],
  "properties": {
    "chunk_id": {"type": "string", "minLength": 1},
    "text": {"type": "string", "minLength": 1},
    "accession_number": {"type": "string", "pattern": "^[0-9]{10}-[0-9]{2}-[0-9]{6}$"},
    "cik": {"type": "string", "pattern": "^[0-9]{10}$"},
    "company_name": {"type": "string", "minLength": 1},
    "ticker": {"type": ["string", "null"]},
    "form": {"type": "string", "minLength": 1},
    "filing_date": {"type": "string", "format": "date"},
    "reporting_period_end": {"type": ["string", "null"], "format": "date"},
    "chunk_index": {"type": "integer", "minimum": 0},
    "section_id": {"type": ["string", "null"]},
    "section_type": {"type": ["string", "null"]},
    "original_title": {"type": ["string", "null"]},
    "is_table": {"type": "boolean"},
    "source_url": {"type": "string", "minLength": 1},
    "chunking_version": {"type": "string", "minLength": 1},
    "extraction_version": {"type": "string", "minLength": 1},
    "source_sha256": {"type": ["string", "null"]},
    "offset_start": {"type": ["integer", "null"], "minimum": 0},
    "offset_end": {"type": ["integer", "null"], "minimum": 0},
    "section_topic": {"type": ["string", "null"]},
    "parent_chunk_id": {"type": ["string", "null"]},
    "language": {"type": ["string", "null"]},
    "processing_timestamp": {"type": ["string", "null"], "format": "date-time"}
  },
  "additionalProperties": true
}
